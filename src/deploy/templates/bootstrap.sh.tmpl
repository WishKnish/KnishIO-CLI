#!/usr/bin/env bash
# KnishIO bare-metal bootstrap — generated by `knishio deploy bootstrap`.
# Encodes deploy/BARE-METAL-DEPLOYMENT.md §1–§7 + day-2 timers, with every
# hard gate learned from the first live run (findings F-1..F-13 in
# docs/audits/TESTNET-DEPLOY-2026-07-23.md).
#
# Run ONCE as root:  sudo bash knishio-bootstrap.sh /path/to/knishio-validator-<ver>-linux-<arch>.tar.gz
# Idempotent-ish: existing secrets/.env/db are preserved on re-run.
set -euo pipefail

TARBALL="${1:?usage: bootstrap.sh <tarball-path>}"
[ -f "$TARBALL" ] || { echo "FATAL: tarball not found: $TARBALL"; exit 1; }
DIR="$(basename "$TARBALL" .tar.gz)"

echo "== PGDG PostgreSQL {{PG_MAJOR}} + pgvector (parity with the pgvector/pg{{PG_MAJOR}} compose pins) =="
apt-get update
apt-get install -y curl ca-certificates
install -d /usr/share/postgresql-common/pgdg
curl -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc --fail \
  https://www.postgresql.org/media/keys/ACCC4CF8.asc
. /etc/os-release
echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt ${VERSION_CODENAME}-pgdg main" \
  > /etc/apt/sources.list.d/pgdg.list
apt-get update
apt-get install -y postgresql-{{PG_MAJOR}} postgresql-{{PG_MAJOR}}-pgvector
pg_lsclusters

echo "== Runbook §1: knishio system user =="
id knishio >/dev/null 2>&1 || \
  useradd --system --home /var/lib/knishio --shell /usr/sbin/nologin knishio

echo "== Runbook §2: provision database (F-13: uuid-ossp MUST be pre-created — the init migration runs it as the non-superuser app role) =="
if ! sudo -u postgres psql -tAc "SELECT 1 FROM pg_database WHERE datname='knishio'" | grep -q 1; then
  DBPASS=$(openssl rand -hex 24)   # hex, never base64 — +/= break DSN parsing
  sudo -u postgres psql -c "CREATE DATABASE knishio;"
  sudo -u postgres psql -c "CREATE USER knishio WITH PASSWORD '${DBPASS}';"
  sudo -u postgres psql -d knishio <<'SQL'
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";
CREATE EXTENSION IF NOT EXISTS vector;
GRANT CONNECT ON DATABASE knishio TO knishio;
GRANT USAGE, CREATE ON SCHEMA public TO knishio;
GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA public TO knishio;
GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA public TO knishio;
ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON TABLES TO knishio;
ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON SEQUENCES TO knishio;
SQL
else
  echo "database knishio already exists — preserving (password unchanged)"
  DBPASS=""
fi
# HARD GATE (F-8): pgvector must exist BEFORE first boot — package missing =
# silent no-op migration recorded applied (never re-runs); present-but-not-
# created = loud permission failure. Also gate the >=0.7 halfvec floor.
VECVER=$(sudo -u postgres psql -d knishio -tAc "SELECT extversion FROM pg_extension WHERE extname='vector'")
[ -n "$VECVER" ] || { echo "FATAL: vector extension missing"; exit 1; }
case "$VECVER" in 0.[0-6].*) echo "FATAL: pgvector $VECVER < 0.7.0 (halfvec/HNSW floor)"; exit 1;; esac
echo "pgvector extension version: $VECVER"

echo "== Runbook §3: install from tarball (SHAKE256 chain-of-custody) =="
WORK=$(mktemp -d)
tar xzf "$TARBALL" -C "$WORK"
cd "$WORK/$DIR"
echo "SHAKE256 (computed vs SHAKE256SUMS — must also match the boot journal):"
python3 -c "import hashlib; print(hashlib.shake_256(open('knishio-validator','rb').read()).hexdigest(32))"
cat SHAKE256SUMS
COMPUTED=$(python3 -c "import hashlib; print(hashlib.shake_256(open('knishio-validator','rb').read()).hexdigest(32))")
grep -q "$COMPUTED" SHAKE256SUMS || { echo "FATAL: SHAKE256 mismatch — tarball tampered or corrupt"; exit 1; }
install -m 755 -o root -g root knishio-validator         /usr/local/bin/
install -m 644 -o root -g root knishio-validator.service /etc/systemd/system/
install -d -m 700 -o knishio -g knishio /var/lib/knishio
install -d -m 750 -o knishio -g knishio /etc/knishio
install -m 755 -o root -g root upgrade.sh health-monitor.sh /usr/local/bin/
# F-1 gate: DIRECTIVE-ONLY check (comments mentioning docker are fine)
grep -qE '^(Requires|After)=.*docker\.service' /etc/systemd/system/knishio-validator.service \
  && { echo "FATAL: unit still hard-couples docker.service"; exit 1; } || true

echo "== Runbook §4: secrets + env (F-10: VALIDATOR_KEM_SECRET is REQUIRED in production) =="
if [ ! -f /etc/knishio/jwt.secret ]; then
  (umask 077
   openssl rand -hex 48 | tr -d '\n' > /etc/knishio/jwt.secret
   openssl rand -hex 48 | tr -d '\n' > /etc/knishio/kem.secret)
  chown knishio:knishio /etc/knishio/jwt.secret /etc/knishio/kem.secret
  chmod 600 /etc/knishio/jwt.secret /etc/knishio/kem.secret
else
  echo "secrets already present — preserving"
fi
if [ ! -f /etc/knishio/.env ]; then
  [ -n "$DBPASS" ] || { echo "FATAL: no .env yet but DB pre-existed — set DATABASE_URL manually in /etc/knishio/.env"; exit 1; }
  cat > /etc/knishio/.env <<ENVEOF
{{ENV_CONTENT}}
ENVEOF
  sed -i "s|__KNISHIO_DB_PASS__|${DBPASS}|" /etc/knishio/.env
  chown knishio:knishio /etc/knishio/.env && chmod 600 /etc/knishio/.env
else
  echo "/etc/knishio/.env already present — preserving"
fi
# F-11: dotenvy also loads a stray .env from the CWD (/var/lib/knishio)
[ ! -e /var/lib/knishio/.env ] || { echo "FATAL: stray /var/lib/knishio/.env"; exit 1; }

echo "== CD groundwork: scoped sudoers for {{DEPLOY_USER}} =="
cat > /etc/sudoers.d/knishio-deploy <<'EOF'
{{SUDOERS_CONTENT}}
EOF
chmod 440 /etc/sudoers.d/knishio-deploy
# Validate ONLY our file — hosting panels (e.g. Forge) ship sudoers files with
# non-0440 modes that fail a global `visudo -c`.
visudo -cf /etc/sudoers.d/knishio-deploy

echo "== Day-2 ops: readiness probe + backup-prune timers =="
cat > /etc/systemd/system/knishio-health.service <<'EOF'
[Unit]
Description=KnishIO readiness probe (one-shot)
[Service]
Type=oneshot
Environment=URL=http://127.0.0.1:{{SERVER_PORT}}/readyz
ExecStart=/usr/local/bin/health-monitor.sh --once
EOF
cat > /etc/systemd/system/knishio-health.timer <<'EOF'
[Unit]
Description=KnishIO readiness probe every 2 minutes
[Timer]
OnBootSec=2min
OnUnitActiveSec=2min
[Install]
WantedBy=timers.target
EOF
cat > /etc/systemd/system/knishio-backup-prune.service <<'EOF'
[Unit]
Description=Prune KnishIO deploy-time pg_dump backups older than 14 days
[Service]
Type=oneshot
ExecStart=/usr/bin/find /var/lib/knishio/backups -name 'knishio-*.sql' -mtime +14 -delete
EOF
cat > /etc/systemd/system/knishio-backup-prune.timer <<'EOF'
[Unit]
Description=Weekly prune of KnishIO deploy backups
[Timer]
OnCalendar=weekly
Persistent=true
[Install]
WantedBy=timers.target
EOF

echo "== Runbook §7: start & verify (F-3: compare applied==expected FROM THE ENDPOINT — never hardcode the count) =="
systemctl daemon-reload
systemctl enable --now knishio-validator
systemctl enable --now knishio-health.timer knishio-backup-prune.timer
READY=0
for i in $(seq 1 40); do
  curl -fsS "http://127.0.0.1:{{SERVER_PORT}}/readyz" >/dev/null 2>&1 && { READY=1; break; }
  sleep 3
done
if [ "$READY" != 1 ]; then
  echo "FATAL: /readyz not ready within 120s — journal follows:"
  journalctl -u knishio-validator -n 80 --no-pager
  exit 1
fi
curl -fsS "http://127.0.0.1:{{SERVER_PORT}}/readyz" | python3 -c "
import sys, json
d = json.load(sys.stdin)
m = d.get('migrations', {})
ok = m.get('applied') == m.get('expected')
print(f\"readyz: {d.get('status')} migrations {m.get('applied')}/{m.get('expected')}\")
sys.exit(0 if ok else 1)
"
echo "== Boot journal SHAKE256 (must equal the install-time hash above) =="
journalctl -u knishio-validator --no-pager | grep -i "binary_shake256" | tail -1 || true
echo "== BOOTSTRAP COMPLETE =="
