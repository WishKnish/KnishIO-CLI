# Config is PURE ENV — this file is the validator's single config surface
# (systemd EnvironmentFile). Secrets ride the *_FILE convention: generated
# ON-SERVER by the bootstrap, never embedded in artifacts.
KNISHIO_ENV=production
SERVER_HOST={{SERVER_HOST}}
SERVER_PORT={{SERVER_PORT}}
DATABASE_URL=postgres://knishio:__KNISHIO_DB_PASS__@127.0.0.1:5432/knishio
DATABASE_MIN_CONNECTIONS=2
DATABASE_MAX_CONNECTIONS=10
JWT_SECRET_FILE=/etc/knishio/jwt.secret
VALIDATOR_KEM_SECRET_FILE=/etc/knishio/kem.secret
TOKEN_EXPIRY_HOURS=24
RUST_LOG=info
JSON_LOGGING=true
CORS_ORIGINS={{CORS_ORIGINS}}
{{TRUSTED_PROXY_LINE}}
