# {{DOMAIN}} — KnishIO validator reverse proxy (Laravel Forge flavor).
# Generated by `knishio deploy edge --flavor forge`. Paste into
# Forge -> site -> Edit Nginx Configuration (replace the whole file).
#
# Deliberately does NOT include forge-conf/{{FORGE_SERVER_ID}}/site.conf — its
# `location /` try_files collides with the proxy; its TLS hardening is
# inlined below. The port-80→443 redirect lives in the before/* include.

# FORGE CONFIG (DO NOT REMOVE!)
include forge-conf/{{FORGE_SERVER_ID}}/before/*;
include forge-conf/{{FORGE_SERVER_ID}}/{{DOMAIN}}/before/*;

# WebSocket upgrade handling (map must sit at http scope).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    http2 on;
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{DOMAIN}};
    server_tokens off;

    # FORGE SSL (DO NOT REMOVE!)
    ssl_certificate {{SSL_CERT_PATH}};
    ssl_certificate_key {{SSL_KEY_PATH}};

    # TLS hardening (inlined from Forge's shared site.conf)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_dhparam /etc/nginx/dhparams.pem;

    client_max_body_size 10m;
    add_header Strict-Transport-Security "max-age=31536000" always;

    access_log off;

    location = /api/ask-stream {
        proxy_pass http://127.0.0.1:{{UPSTREAM_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location ~ ^/(graphql/ws|ws)$ {
        proxy_pass http://127.0.0.1:{{UPSTREAM_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location = /metrics { return 404; }
    location = /config  { return 404; }

    location / {
        proxy_pass http://127.0.0.1:{{UPSTREAM_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}

# FORGE CONFIG (DO NOT REMOVE!)
include forge-conf/{{FORGE_SERVER_ID}}/after/*;
include forge-conf/{{FORGE_SERVER_ID}}/{{DOMAIN}}/after/*;
